# Agent Lab configuration (Req 1.5, Req 1.7, Req 17.3)
#
# Copy this file to `.env` and edit the values. `.env` is git-ignored; this file
# is committed and holds PLACEHOLDER VALUES ONLY -- no real credential ever
# belongs here (Req 17.3).
#
# Every variable Agent Lab reads appears exactly once below. Each row is three
# lines in a fixed, machine-parseable shape, so `tests/test_properties.py` can
# read this file as the oracle for configuration validation (Property 19):
#
#   # <NAME> -- one-line description of what the variable does.
#   # default: <value applied when the variable is absent or empty> | range: <accepted values>
#   <NAME>=<placeholder value>
#
# The `range:` field is one of:
#   integer <lo>..<hi>    inclusive integer bounds
#   decimal <lo>..<hi>    inclusive decimal bounds
#   enum <a>|<b>|...      one of the listed values, compared case-sensitively
#   string                any non-empty string
#   path                  a filesystem path, absolute or relative to the repository root
# `default: required` marks a variable with no default: the run exits 6 when it
# is absent or empty (Req 1.8).


# --- Provider and model -------------------------------------------------------

# PROVIDER -- which provider adapter to construct; selects the API key variable too.
# default: openai | range: enum openai
PROVIDER=openai

# MODEL_ID -- the model identifier passed to the provider on every call.
# default: gpt-4o-mini | range: string
MODEL_ID=gpt-4o-mini

# OPENAI_API_KEY -- credential for the selected provider; named <PROVIDER>_API_KEY.
# default: required | range: string
OPENAI_API_KEY=sk-your-key-here


# --- Paths --------------------------------------------------------------------

# DOCS_DIR -- directory walked to build the retrieval index over your documents.
# default: sample_notes | range: path
DOCS_DIR=sample_notes

# NOTES_FILE -- the single file `save_note` appends to and `read_notes` reads.
# default: notes.md | range: path
NOTES_FILE=notes.md

# TRACE_FILE -- JSON-lines trace, one object appended per completed step.
# default: traces/run.jsonl | range: path
TRACE_FILE=traces/run.jsonl

# CHROMA_DIR -- persistence directory for the Chroma retrieval index.
# default: .chroma | range: path
CHROMA_DIR=.chroma


# --- Run bounds ---------------------------------------------------------------

# MAX_STEPS -- hard ceiling on think-act-observe iterations in one run.
# default: 8 | range: integer 1..50
MAX_STEPS=8

# COST_CAP -- spend ceiling in USD for one run, checked before each model call.
# default: 0.25 | range: decimal 0.01..100.00
COST_CAP=0.25


# --- Tool execution limits ----------------------------------------------------

# TOOL_TIMEOUT_SECONDS -- per-tool wall-clock limit before the call returns an error.
# default: 10 | range: decimal 1..60
TOOL_TIMEOUT_SECONDS=10

# TOOL_RESULT_MAX_CHARS -- tool results longer than this are truncated with a marker.
# default: 4000 | range: integer 500..20000
TOOL_RESULT_MAX_CHARS=4000

# NOTES_READ_BUDGET -- character budget `read_notes` fills with the newest whole entries.
# default: 8000 | range: integer 500..50000
NOTES_READ_BUDGET=8000


# --- Terminal output ----------------------------------------------------------

# DISPLAY_MAX_CHARS -- per-line terminal truncation; does not affect the trace.
# default: 500 | range: integer 80..10000
DISPLAY_MAX_CHARS=500


# --- Retrieval chunking -------------------------------------------------------

# CHUNK_SIZE -- character width of each indexed document chunk.
# default: 1000 | range: integer 200..4000
CHUNK_SIZE=1000

# CHUNK_OVERLAP -- characters each chunk repeats from the previous one.
# default: 150 | range: integer 0..CHUNK_SIZE-1
CHUNK_OVERLAP=150


# --- Evaluation suite ---------------------------------------------------------

# EVAL_COST_CEILING -- cumulative USD ceiling for one full eval suite execution.
# default: 5.00 | range: decimal 0.01..100.00
EVAL_COST_CEILING=5.00


# --- Optional stretch features (Req 18) ---------------------------------------
#
# Each variable below is optional, and each documented default is that feature's
# DISABLED state. A copy of this file with nothing but the API key filled in runs
# exactly the required scope with every stretch feature off (Req 18.6). An empty
# value is the same as an unset one (Req 1.7), which is why the placeholders here
# are the disabled values rather than examples of enabled ones.

# STREAM_OUTPUT -- "on" writes provider output tokens to stdout as they arrive.
# default: off | range: enum on|off
STREAM_OUTPUT=off

# WEB_SEARCH -- "on" registers an optional fifth tool, the documented four-tool exception.
# default: off | range: enum on|off
WEB_SEARCH=off

# MEMORY_FILE -- file read into the run's initial conversation state; empty disables it.
# default:  | range: string
MEMORY_FILE=

# COMPARE_MODEL_ID -- second model the eval suite compares against MODEL_ID; empty runs one.
# default:  | range: string
COMPARE_MODEL_ID=
