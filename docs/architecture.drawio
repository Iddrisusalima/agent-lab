      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p1-task" value="agentlab run TASK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="360" y="40" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p1-valid" value="task is 1 to 4000 characters after trimming?" style="rounded=1;whiteSpace=wrap;html=1;shape=rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="340" y="140" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p1-invalid" value="stop: invalid_task, exit 5. No model call, no trace line" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="760" y="155" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1-stepbound" value="completed steps below MAX_STEPS, which is 8?" style="rounded=1;whiteSpace=wrap;html=1;shape=rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="340" y="290" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p1-limit" value="stop: step_limit_reached, exit 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="760" y="305" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1-costbound" value="spend so far below COST_CAP, which is 0.25 dollars?" style="rounded=1;whiteSpace=wrap;html=1;shape=rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="340" y="440" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p1-capped" value="stop: cost_cap_reached, exit 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="760" y="455" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1-call" value="model call: system prompt, conversation, registry schemas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="360" y="590" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1-failed" value="stop: model_error, exit 4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="760" y="595" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1-spend" value="record this call's tokens and dollars" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="360" y="720" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p1-reply" value="what the reply contained" style="rounded=1;whiteSpace=wrap;html=1;shape=rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="340" y="840" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p1-answer" value="stop: final_answer, exit 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="760" y="855" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1-dispatch" value="dispatch each call, in reply order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="360" y="1000" width="280" height="70" as="geometry" />
