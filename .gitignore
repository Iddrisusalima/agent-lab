__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.hypothesis/

# Virtual environments
.venv/
venv/

# Kiro's internal spec bookkeeping (the spec documents themselves are committed)
.config.kiro
tasks.meta.json
